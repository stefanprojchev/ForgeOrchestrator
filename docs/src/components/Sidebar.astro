---
import { resolveHref } from "../config";

interface NavItem {
  title: string;
  href?: string;
  children?: { title: string; href: string }[];
}

interface Props {
  items: NavItem[];
  section: string;
}

const { items, section } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<aside class="hidden w-52 shrink-0 lg:block">
  <nav class="sticky top-20">
    <h3 class="mb-3 font-mono text-[11px] font-medium uppercase tracking-widest text-muted-foreground">{section}</h3>
    <ul class="space-y-0.5">
      {items.map((item) => {
        if (item.children) {
          return (
            <li class="pt-2">
              <span class="block px-3 pb-1 font-mono text-[11px] font-medium uppercase tracking-widest text-muted-foreground/60">{item.title}</span>
              <ul class="space-y-0.5">
                {item.children.map((child) => {
                  const fullHref = resolveHref(child.href);
                  const active = currentPath === fullHref.replace(/\/$/, "");
                  return (
                    <li>
                      <a
                        href={fullHref}
                        class:list={[
                          "relative block rounded-md px-3 py-1.5 text-[13px] transition-all",
                          active
                            ? "bg-amber-400/10 font-medium text-amber-400"
                            : "text-muted-foreground hover:bg-accent hover:text-foreground",
                        ]}
                      >
                        {active && <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-amber-400" />}
                        {child.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        }

        const fullHref = resolveHref(item.href!);
        const active = currentPath === fullHref.replace(/\/$/, "");
        return (
          <li>
            <a
              href={fullHref}
              class:list={[
                "relative block rounded-md px-3 py-1.5 text-[13px] transition-all",
                active
                  ? "bg-amber-400/10 font-medium text-amber-400"
                  : "text-muted-foreground hover:bg-accent hover:text-foreground",
              ]}
            >
              {active && <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-amber-400" />}
              {item.title}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>
